// One-Worker deployment, without Pages: the agent Worker also serves the web UI.
// Build the UI first (npm run build -w @talorys/web), then set the OWNER_PASSWORD
// (or OWNER_PASSWORD_HASH) and SESSION_SECRET secrets. VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY
// turn on push notifications (optional; see docs/deployment.md).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "talorys",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Older uploaded versions must not stay reachable on their own preview URLs.
  "preview_urls": false,
  // Public on <name>.<subdomain>.workers.dev, behind the app's own login. The GitHub deploy
  // turns this off when a custom domain is set.
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request meets the Worker first, so the HTTPS redirect, the allowed hosts, the
    // Access check and the security headers cover the UI too, not only /api.
    "run_worker_first": true
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "TalorysAgent", "class_name": "TalorysAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TalorysAgent"] }],
  "observability": { "enabled": true }
}
